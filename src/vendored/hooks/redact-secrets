#!/bin/sh
# Replace secrets that appear in a tool's output before they reach the agent. Called from
# the runtime's PostToolUse hook (AUT-275).
#
# A shell around the implementation, so that the hook settings do not depend on its language.
# Always ends with 0, so as not to stop the agent over this.
dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
node "$dir/internal/redactSecrets.js" || true
exit 0
