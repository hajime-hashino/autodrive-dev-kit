{
  "name": "{{NAME}}",
  "image": "mcr.microsoft.com/devcontainers/base:debian",

  // This file belongs to the project. **Write what you want to add directly here.**
  // The kit does not overwrite it (when the template changes, update reports the difference).
  //
  // But the three below (runArgs / postStartCommand / remoteUser) are needed to
  // narrow outbound traffic. **Remove them and invariants fails** (AUT-121, AUT-157).
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Needed to narrow outbound traffic. Without it, the egress cannot be closed.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],

  // Keep authentication and settings across rebuilds of the environment.
  // Including ${devcontainerId} keeps it from mixing with other projects.
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Stop fetching feature flags. Reduces the destinations to allow.
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },

  // Setup only needs to run on creation. Additions to rc files and git settings persist.
  // **Do not put the check here.** It runs before the egress is closed, so it would always
  // falsely report "not in effect" (below).
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // **The egress is closed on every start.** iptables rules live in the container's
  // network namespace, so they disappear when it stops. postCreateCommand runs only
  // on creation, so placing it there means **no isolation from the first restart onward.**
  // That is what actually happened (AUT-121).
  //
  // Closing the egress needs root. The agent does not run as root.
  //
  // **The setup check runs right after closing.** While it sat in postCreateCommand,
  // the check reported "the egress restriction is not in effect" every time. **devcontainer
  // runs postCreate → postStart, so at check time it is always not yet closed.**
  // The check itself says it is "the last net for noticing that init-firewall.sh did not run,"
  // yet it was placed before closing (AUT-169).
  //
  // **Do not remove `|| true`.** On first start having no .env yet is normal, and treating
  // the start as failed there shows red before you can get in and fix it. If the egress
  // could not be closed, init-firewall.sh itself fails with 1, so that is not hidden.
  "postStartCommand": "sudo bash .devcontainer/init-firewall.sh && { bash .devcontainer/check-setup.sh || true; }",
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  }
}
